{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" }
      ]
    }
  ],
  "redirects": [
    { "source": "/agenda", "destination": "/", "permanent": true },
    { "source": "/index.html", "destination": "/", "permanent": true }
  ],
  "rewrites": [
    { "source": "/sign-in", "destination": "/auth.html" },
    { "source": "/sign-up", "destination": "/auth.html" },
    { "source": "/auth/verify", "destination": "/auth.html" },
    { "source": "/dasbor", "destination": "/index.html" },
    { "source": "/materi", "destination": "/index.html" },
    { "source": "/tracker", "destination": "/index.html" },
    { "source": "/tryout", "destination": "/index.html" },
    { "source": "/panduan", "destination": "/index.html" }
  ]
}
