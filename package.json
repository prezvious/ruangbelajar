{
  "name": "ruangbelajar",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node --env-file=.env.local dev-server.js",
    "test": "node tests/run.mjs",
    "format": "prettier --write \"study/**/*.{mjs,css}\" \"api/*.js\" \"tests/*.mjs\" dev-server.js \"*.html\" package.json vercel.json",
    "format:check": "prettier --check \"study/**/*.{mjs,css}\" \"api/*.js\" \"tests/*.mjs\" dev-server.js \"*.html\" package.json vercel.json",
    "test:http": "node tests/http-server.test.mjs",
    "vendor:sync": "node scripts/vendor-modules.mjs",
    "test:database": "node tests/database.test.mjs",
    "test:browser": "node tests/learning-browser.test.mjs",
    "vendor:check": "node scripts/vendor-modules.mjs --check"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.11",
    "@playwright/test": "1.64.1",
    "fake-indexeddb": "6.2.6",
    "prettier": "3.6.2"
  },
  "dependencies": {
    "dompurify": "3.4.17",
    "marked": "18.1.1"
  }
}
